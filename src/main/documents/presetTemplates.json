{
  "version": "2.0",
  "remark": "系统预置单据模板（seed 数据），应用启动时由 seedPresetTemplates 写入 document_templates 表，is_builtin=1",
  "templates": [
    {
      "name": "合同模板",
      "category": "合同类",
      "description": "通用商务合同关键信息提取",
      "fields": [
        {
          "key": "party_a",
          "label": "甲方名称",
          "type": "string",
          "desc": "合同中甲方（发包方/采购方）的全称，落款处全称，不用简称"
        },
        {
          "key": "party_b",
          "label": "乙方名称",
          "type": "string",
          "desc": "合同中乙方（承包方/供应方）的全称，落款处全称，不用简称"
        },
        {
          "key": "contract_amount",
          "label": "合同金额",
          "type": "number",
          "desc": "合同总价款，含税总金额，数值型；大小写冲突时以小写为准并标黄"
        },
        {
          "key": "sign_date",
          "label": "签订日期",
          "type": "date",
          "desc": "落款日期；双方日期不同取晚者并标黄",
          "required": false
        },
        {
          "key": "term",
          "label": "合同期限",
          "type": "string",
          "desc": "履行期限或起止时间，如'2026-01-01至2026-12-31'"
        },
        {
          "key": "payment_terms",
          "label": "付款方式",
          "type": "string",
          "desc": "付款条件与方式，如'分期付款、预付30%'"
        },
        {
          "key": "contract_no",
          "label": "合同编号",
          "type": "string",
          "desc": "合同上的编号"
        },
        {
          "key": "contract_name",
          "label": "合同名称",
          "type": "string",
          "desc": "首页标题"
        },
        {
          "key": "contract_type",
          "label": "合同类型",
          "type": "enum",
          "desc": "",
          "required": false,
          "enum_values": ["采购合同", "销售合同", "服务合同", "框架协议"]
        },
        {
          "key": "subject_matter",
          "label": "合同标的",
          "type": "string",
          "desc": "采购/销售货物或服务内容，一句话",
          "required": false
        },
        {
          "key": "tax_rate",
          "label": "税率",
          "type": "enum",
          "desc": "",
          "required": false,
          "enum_values": ["13%", "9%", "6%", "3%", "1%", "含税未注明", "不含税"]
        },
        {
          "key": "payment_schedule",
          "label": "付款节点",
          "type": "array",
          "desc": "字段值为 JSON 数组，元素结构：[{milestone(节点说明), ratio(比例), amount(金额（元）), trigger(触发条件)}]，如无则填 null",
          "required": false
        },
        {
          "key": "start_date",
          "label": "合同起始日",
          "type": "date",
          "desc": "",
          "required": false
        },
        {
          "key": "end_date",
          "label": "合同到期日",
          "type": "date",
          "desc": "",
          "required": false
        },
        {
          "key": "breach_clause",
          "label": "违约责任摘要",
          "type": "string",
          "desc": "提取违约金比例/计算方式，如\"日万分之五\"",
          "required": false
        },
        {
          "key": "seal_status",
          "label": "盖章状态",
          "type": "enum",
          "desc": "扫描件看落款印章",
          "required": false,
          "enum_values": ["双方已盖章", "仅甲方盖章", "仅乙方盖章", "未盖章", "无法判断"]
        }
      ]
    },
    {
      "name": "行程单模板",
      "category": "出行票据类",
      "description": "机票/火车票（含高铁票）行程单信息提取",
      "fields": [
        {
          "key": "passenger_name",
          "label": "乘客姓名",
          "type": "string",
          "desc": "乘车/乘机人姓名"
        },
        {
          "key": "id_number",
          "label": "证件号（脱敏）",
          "type": "string",
          "desc": "身份证号，保留原样脱敏格式"
        },
        {
          "key": "departure",
          "label": "出发地",
          "type": "string",
          "desc": "出发城市或车站/机场，如'北京南'、'首都机场T3'"
        },
        {
          "key": "destination",
          "label": "到达地",
          "type": "string",
          "desc": "到达城市或车站/机场"
        },
        {
          "key": "depart_date",
          "label": "出发日期",
          "type": "date",
          "desc": "出发日期，YYYY-MM-DD"
        },
        {
          "key": "depart_time",
          "label": "出发时间",
          "type": "string",
          "desc": "发车/起飞时间，HH:MM"
        },
        {
          "key": "arrive_time",
          "label": "到达时间",
          "type": "string",
          "desc": "到站/落地时间，HH:MM，票面无则填null"
        },
        {
          "key": "vehicle_no",
          "label": "航班号/车次",
          "type": "string",
          "desc": "航班号，或高铁/火车车次（G/C/D/Z/T/K字头，如G101）"
        },
        {
          "key": "seat_class",
          "label": "座位等级",
          "type": "string",
          "desc": "舱位/坐席，如经济舱、商务座、一等座、二等座、硬卧"
        },
        {
          "key": "seat_no",
          "label": "车厢及座位号",
          "type": "string",
          "desc": "火车票车厢号+座位号，如'07车12F号'，机票无则填null"
        },
        {
          "key": "fare",
          "label": "票价",
          "type": "number",
          "desc": "票面价格"
        },
        {
          "key": "tax_fee",
          "label": "税费",
          "type": "number",
          "desc": "机场建设费/燃油费等税费，火车票无则填null"
        },
        {
          "key": "ticket_type",
          "label": "票据类型",
          "type": "string",
          "desc": "航空/高铁/普速火车/其他"
        },
        {
          "key": "ticket_no",
          "label": "票号",
          "type": "string",
          "desc": "电子客票号或订单号"
        }
      ]
    },
    {
      "name": "住宿单模板",
