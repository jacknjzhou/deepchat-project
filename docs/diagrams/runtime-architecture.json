  "cards": [
    {
      "dot": "cyan",
      "title": "启动与组合根",
      "items": [
        "appMain.ts：single-instance 锁、deeplink 缓存、whenReady → startMainProcess",
        "mainProcess.ts：创建 splash → settings/secret → 数据库解锁+迁移 → 注册协议",
        "composition.ts：唯一组合根，创建模块 → registerRoutes → 依序 start，重名 route 直接抛错",
        "窗口可用后延迟启动 floating、skill sync、MCP、remote runtime、provider warmup"
      ]
    },
    {
      "dot": "emerald",
      "title": "请求链（Renderer → Main）",
      "items": [
        "Renderer SPA → api/XxxClient → core.invokeDeepchatRoute → window.deepchat.invoke",
        "Preload createBridge：按 shared route 契约 zod 校验输入，返回前校验输出",
        "ipcMain.handle('deepchat:route:invoke') → dispatchDeepchatRoute → 模块 route map handler",
        "原生能力（SQLite/duckdb/sharp/node-pty/OCR）只存在于 main，renderer 拿不到 Node"
      ]
    },
    {
      "dot": "violet",
      "title": "Session 与 Agent 运行",
      "items": [
        "SessionLifecycle 负责创建/草稿/关闭；SessionTurn 负责 send / queue / steer / cancel / interact",
        "SessionAssignmentPolicy 解析 Agent、model、project、fork 与 subagent 归属",
        "AgentManager 按 descriptor.kind 选择 DeepChat LoopEngine 或 ACP runtime",
        "一个已载入 Session 对应一个 Instance；每次 Turn 创建独立 Run（取消信号 / provider round / requestSeq）"
      ]
    },
    {
      "dot": "amber",
      "title": "DeepChat 执行循环",
      "items": [
        "读取 Session 数据并准备 prompt → ProviderRuntime.streamChat 发起流式请求",
        "更新 message projection → 判断是否产生 tool 调用",
        "ToolService 执行（catalog / 权限预检 / 执行路由），需要用户交互时暂停并保存",
        "写入 Tape tool fact → 进入下一轮；terminal / maxProviderRounds / maxToolCalls 后 settle Turn",
        "恢复交互时最后一项完成后创建新的 resume Run"
      ]
    },
    {
      "dot": "rose",
      "title": "能力与数据模块",
      "items": [
        "Provider：provider DB 来源链（远端 → 缓存 → 内置），负责模型请求与认证",
        "Tool / MCP / Skill / Plugin：工具目录、server-client 生命周期、Skill 发现与同步",
        "Memory：DuckDB VSS 向量库 + 后台维护；Knowledge：内置 RAG，同时以 MCP server 暴露",
        "Data：MainDatabase 只做连接/事务/迁移/备份，各模块自持 table；Tape 记录结构化工作轨迹"
      ]
    },
    {
      "dot": "orange",
      "title": "入口与后台进程",
      "items": [
        "Desktop：window/tab/tray/shortcut + DesktopSessionBinding，窗口关闭不删除 Session",
        "Remote：飞书 / Telegram / QQBot / Discord / WeChat 频道，复用同一套 Session 生命周期",
        "Scheduler：cron 到期后创建 detached Session 跑 Turn，再按需投递结果",
        "Utility 子进程：OCR helper、scheduler、fileWatcher、codeMode、backgroundExec"
      ]
    }
  ]
}
