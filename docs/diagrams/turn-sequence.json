  "cards": [
    {
      "dot": "emerald",
      "title": "发起 Turn：契约先行",
      "items": [
        "Renderer 只调用 window.deepchat.invoke，不直接接触 Node 与原生能力",
        "Preload createBridge 按 shared route 契约校验输入与输出，失败即拒绝",
        "Route Registry 是唯一分发点，重名 route 在组合根启动阶段直接抛错",
        "Session 域负责创建 Session / Turn，并由 AssignmentPolicy 解析 Agent 与 model"
      ]
    },
    {
      "dot": "cyan",
      "title": "Provider 轮次：流式优先",
      "items": [
        "AgentManager 按 descriptor.kind 选择 DeepChat LoopEngine 或 ACP runtime",
        "每次 Turn 创建独立 Run，持有取消信号、provider round 与 requestSeq",
        "ProviderRuntime.streamChat 走 AI SDK 向供应商发起 HTTPS 流式请求",
        "token 流与 message delta 逐段回填 message projection，不必等待整段完成"
      ]
    },
    {
      "dot": "amber",
      "title": "工具循环：交替推进",
      "items": [
        "检测到 tool call 后由 ToolService 执行 catalog、权限预检与执行路由",
        "需要用户交互时暂停并保存现场，恢复后创建新的 resume Run",
        "tool result 回填后进入下一轮 provider round",
        "终态由 terminal、maxProviderRounds 或 maxToolCalls 判定"
      ]
    },
    {
      "dot": "violet",
      "title": "事件回传：typed event",
      "items": [
        "Agent 通过 TypedEventHub 与 SessionEventRouter 发出结构化事件",
        "事件经 Preload 分发回 Renderer，UI 侧按类型增量更新",
        "该链路与请求链解耦，长任务可在后台继续推进",
        "渲染进程始终不持有 Node 权限，回传内容仍是契约化数据"
      ]
    },
    {
      "dot": "rose",
      "title": "落库与 settle",
      "items": [
        "工具事实写入 Session Tape，形成结构化工作轨迹",
        "MainDatabase 只负责连接、事务、迁移与备份，各模块自持 table",
        "Turn 结算后 Session 状态与 transcript 保持一致",
        "窗口关闭不会删除 Session，下次载入可继续推进"
      ]
    }
  ]
}
